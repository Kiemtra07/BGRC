        <mxCell id="e14_leader_reject" value="Lãnh đạo trả về → REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#e11d48;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="branch_leader" target="remediate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="285"/><mxPoint x="1770" y="1160"/><mxPoint x="930" y="1160"/><mxPoint x="930" y="450"/></Array></mxGeometry></mxCell>
