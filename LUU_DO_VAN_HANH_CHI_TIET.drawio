      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lane_ho" value="1. KHỐI NỘI BỘ / KHỞI TẠO" style="swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;html=1;fontStyle=1;fontSize=16;fillColor=#eff6ff;swimlaneFillColor=#ffffff;strokeColor=#93c5fd;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="430" height="1130" as="geometry" /></mxCell>
        <mxCell id="lane_sys" value="2. HỆ THỐNG ĐIỀU PHỐI" style="swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;html=1;fontStyle=1;fontSize=16;fillColor=#ecfdf5;swimlaneFillColor=#ffffff;strokeColor=#6ee7b7;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="490" y="80" width="430" height="1130" as="geometry" /></mxCell>
        <mxCell id="lane_branch" value="3. CHI NHÁNH KHẮC PHỤC" style="swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;html=1;fontStyle=1;fontSize=16;fillColor=#f0fdfa;swimlaneFillColor=#ffffff;strokeColor=#5eead4;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="430" height="1130" as="geometry" /></mxCell>
        <mxCell id="lane_cluster" value="4. KIỂM SOÁT CHI NHÁNH" style="swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;html=1;fontStyle=1;fontSize=16;fillColor=#fffbeb;swimlaneFillColor=#ffffff;strokeColor=#fcd34d;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1390" y="80" width="390" height="1130" as="geometry" /></mxCell>
        <mxCell id="lane_internal" value="5. TUYẾN PHÊ DUYỆT CẤP 2" style="swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;html=1;fontStyle=1;fontSize=16;fillColor=#f5f3ff;swimlaneFillColor=#ffffff;strokeColor=#c4b5fd;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1800" y="80" width="700" height="1130" as="geometry" /></mxCell>

        <mxCell id="start" value="BẮT ĐẦU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="170" y="170" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="input" value="Chọn kênh &amp; nhập dữ liệu&#xa;• Excel theo mẫu&#xa;• Web Form / API&#xa;• Chọn đợt, đơn vị, PIC" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="340" height="160" as="geometry" /></mxCell>
        <mxCell id="validate" value="Dữ liệu hợp lệ?&#xa;Đúng schema • đủ trường lõi • không trùng batch" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="270" width="230" height="150" as="geometry" /></mxCell>
        <mxCell id="staging" value="Staging &amp; xác nhận import&#xa;Xem lỗi theo dòng/cột trước khi ghi chính thức" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="540" y="490" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="dispatch" value="Tạo hồ sơ PENDING&#xa;Map Cụm → Chi nhánh → PIC&#xa;Khởi tạo SLA và gửi To-Do" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="540" y="690" width="330" height="140" as="geometry" /></mxCell>
        <mxCell id="receive" value="Tiếp nhận To-Do&#xa;Xem lỗi, căn cứ và hạn xử lý" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0f766e;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="990" y="220" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="remediate" value="Khắc phục nghiệp vụ&#xa;Bổ sung chứng từ • kiểm tra thực địa • hoàn thiện thủ tục" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0f766e;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="990" y="390" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="evidence" value="Tải bằng chứng lên Drive&#xa;Viết giải trình và kế hoạch khắc phục" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="990" y="590" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="complete" value="Hồ sơ đầy đủ?&#xa;File + giải trình" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="760" width="190" height="120" as="geometry" /></mxCell>
        <mxCell id="submit" value="Gửi duyệt theo cấu hình&#xa;Luồng 1, 2 hoặc 3 cấp" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0f766e;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="990" y="960" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="cluster_decision" value="Kiểm soát đồng ý?&#xa;Kiểm tra từng ý, tài liệu và giải trình" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="1470" y="610" width="230" height="160" as="geometry" /></mxCell>
        <mxCell id="branch_leader" value="Lãnh đạo chi nhánh&#xa;THREE_TIER luôn có bước này; TWO_TIER chỉ chèn khi hồ sơ có dấu sao&#xa;Đồng ý → SUBMITTED_INTERNAL · Trả → REJECTED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="1870" y="220" width="540" height="130" as="geometry" /></mxCell>
        <mxCell id="internal_review" value="Phê duyệt HT&#xa;Đối chiếu sai sót, tài liệu, kết quả kiểm soát và quy định" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="1870" y="400" width="540" height="120" as="geometry" /></mxCell>
        <mxCell id="final_decision" value="Đủ điều kiện bỏ lỗi?&#xa;Lãnh đạo phê duyệt cuối" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="2040" y="620" width="220" height="150" as="geometry" /></mxCell>
        <mxCell id="resolved" value="Phê duyệt bỏ lỗi &amp; đóng hồ sơ&#xa;WAIVED_RESOLVED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="1930" y="880" width="440" height="110" as="geometry" /></mxCell>
