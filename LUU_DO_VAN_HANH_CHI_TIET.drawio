  <diagram id="support-flow" name="02 - Bộ máy chạy song song">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s_title" value="CÁC BỘ MÁY CHẠY SONG SONG XUYÊN SUỐT VÒNG ĐỜI HỒ SƠ" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1200" height="50" as="geometry" /></mxCell>
        <mxCell id="s_case" value="HỒ SƠ SAI SÓT&#xa;ONE_TIER: PENDING → SUBMITTED_INTERNAL → WAIVED_RESOLVED&#xa;TWO_TIER: PENDING → SUBMITTED_BRANCH → (dấu sao → SUBMITTED_BRANCH_LEADER) → SUBMITTED_INTERNAL&#xa;THREE_TIER: PENDING → SUBMITTED_BRANCH → SUBMITTED_BRANCH_LEADER → SUBMITTED_INTERNAL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;spacing=14;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="960" height="180" as="geometry" /></mxCell>
        <mxCell id="s_admin" value="ADMIN CONFIG ENGINE&#xa;• Tổ chức, user, role/scope&#xa;• Channel/Schema/Workflow/SLA version&#xa;• Publish cấu hình trước khi tạo hồ sơ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="360" height="200" as="geometry" /></mxCell>
        <mxCell id="s_sla" value="SLA &amp; ESCALATION&#xa;• Chạy 08:30 Asia/Ho_Chi_Minh&#xa;• Xanh / Vàng / OVERDUE&#xa;• OVERDUE là SLA status, không đổi workflow&#xa;• Gia hạn có phê duyệt và audit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;spacing=14;" vertex="1" parent="1"><mxGeometry x="490" y="390" width="360" height="220" as="geometry" /></mxCell>
        <mxCell id="s_drive" value="KHO MINH CHỨNG / DRIVE MỤC TIÊU&#xa;• Chuyên đề/CIF/Mã lỗi&#xa;• Metadata + checksum + version&#xa;• Khóa file sau khi nộp&#xa;• Local hiện lưu binary trên đĩa" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;spacing=14;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="360" height="220" as="geometry" /></mxCell>
        <mxCell id="s_audit" value="AUDIT TRAIL &amp; OUTBOX&#xa;• Append-only: ai, lúc nào, role/scope&#xa;• Trước/sau + lý do + căn cứ&#xa;• Email retry, dedup, delivery log&#xa;• Dashboard áp scope từ API/DB" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;spacing=14;" vertex="1" parent="1"><mxGeometry x="1310" y="390" width="410" height="220" as="geometry" /></mxCell>
        <mxCell id="s_end" value="LƯU TRỮ HỒ SƠ HOÀN TẤT" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="760" width="440" height="80" as="geometry" /></mxCell>
        <mxCell id="se1" value="Cấu hình áp dụng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_admin" target="s_case"><mxGeometry relative="1" as="geometry" /></mxCell>
