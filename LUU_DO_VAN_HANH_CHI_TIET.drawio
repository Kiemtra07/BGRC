        <mxCell id="e14_leader" value="THREE_TIER hoặc TWO_TIER + dấu sao" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#059669;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="cluster_decision" target="branch_leader"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="650"/><mxPoint x="1810" y="285"/></Array></mxGeometry></mxCell>
