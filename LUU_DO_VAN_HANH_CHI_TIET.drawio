        <mxCell id="e13" value="Từ chối - ghi lý do, trả Chi nhánh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#e11d48;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.6;" edge="1" parent="1" source="cluster_decision" target="remediate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1585" y="1120"/><mxPoint x="930" y="1120"/><mxPoint x="930" y="460"/></Array></mxGeometry></mxCell>
