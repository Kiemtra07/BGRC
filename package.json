{
  "name": "audit-bgs-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/app.ts",
    "dev:worker": "tsx watch server/src/worker/sla-worker.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:vercel-function && vite build",
    "build:vercel-function": "node scripts/build-vercel-function.mjs",
    "preview": "vite preview",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:dry-run": "tsx db/migrate.ts --dry-run",
    "db:seed": "tsx db/seed.ts",
    "db:backfill:local-state": "tsx db/backfill-local-state.ts",
    "db:backfill:local-state:dry-run": "tsx db/backfill-local-state.ts --dry-run",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e:reports": "node tests/e2e/reports-smoke.mjs",
    "ci": "npm run db:migrate:dry-run && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:contract && vite build",
    "demo:purge": "tsx db/purge-demo-data.ts",
    "auth:hash-password": "tsx db/hash-password.ts",
    "users:seed-test": "tsx db/create-test-users.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@fontsource/roboto": "^5.2.6",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.1",
    "google-auth-library": "^10.9.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
