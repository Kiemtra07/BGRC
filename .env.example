# Local-only profile. The API is intentionally honest about memory/mock modes.
NODE_ENV=development
PORT=3001
AUTH_MODE=mock-header
DATA_STORE_MODE=local-json
LOCAL_STATE_FILE=./data/local-state.json
# memory does not persist and is suitable only for tests or temporary experiments.
EVIDENCE_STORAGE_MODE=local
# local stores evidence on local disk; it is not Google Drive.
LOCAL_EVIDENCE_DIR=./data/drive_storage
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=/api

# Required only for explicit PostgreSQL migration/seed commands.
# DATABASE_URL=postgresql://audit_bgs:change-me@127.0.0.1:5432/audit_bgs

# Production guard requires OIDC + PostgreSQL + a real Google Drive adapter.
# OIDC_ISSUER_URL=
# OIDC_AUDIENCE=
# Google login (OAuth Web client). Redirect URI production: https://bgrc.vercel.app/api/v1/auth/google/callback
# GOOGLE_OIDC_CLIENT_ID=
# GOOGLE_OIDC_CLIENT_SECRET=
# GOOGLE_OIDC_REDIRECT_URI=
# GOOGLE_OIDC_STATE_SECRET=generate-at-least-32-random-bytes
# Base64-encoded or compact JSON service-account credential. Do not expose through VITE_* variables.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Hoặc dùng Google Drive cá nhân bằng OAuth Web client. Các biến này chỉ ở máy chủ, không dùng VITE_*.
# GOOGLE_DRIVE_AUTH_MODE=oauth-user
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google-drive/callback
# GOOGLE_OAUTH_STATE_SECRET=generate-at-least-32-random-bytes
# GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=64-hex-characters-for-AES-256-GCM
# CRON_SECRET=replace-with-at-least-32-random-bytes
# Server-only Apps Script gateway. Never expose the secret through VITE_* variables.
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# GOOGLE_APPS_SCRIPT_SECRET=replace-with-at-least-32-random-bytes

# Dữ liệu demo (5 tài khoản mẫu, hồ sơ mẫu, chuyên đề mẫu).
# Bật cho môi trường dev; production LUÔN tắt và runtime guard sẽ từ chối khởi động nếu bật.
SEED_DEMO_DATA=true

# Tài khoản quản trị khởi tạo — bắt buộc khi SEED_DEMO_DATA=false (và ở production).
# Sinh hash bằng: npm run auth:hash-password -- "<mật khẩu>"
# KHÔNG đặt mật khẩu thô vào biến môi trường.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULLNAME=
